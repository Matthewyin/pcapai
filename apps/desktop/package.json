{
  "name": "@pcapai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/preload.cjs dist/preload.cjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && PCAPAI_DESKTOP_MODE=dev electron .",
    "start": "PCAPAI_DESKTOP_MODE=prod electron .",
    "pack": "electron-builder --mac dmg --config electron-builder.yml",
    "pack:dir": "electron-builder --mac dir --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^33.4.4",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "keytar": "^7.9.0"
  }
}
